{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "overlay",
  "description": "Selection overlays: one per monitor",
  "windows": ["overlay-*"],
  "permissions": [
    "core:event:default",
    "core:window:allow-set-focus",
    "allow-overlay-loaded",
    "allow-overlay-ready",
    "allow-overlay-claim",
    "allow-overlay-commit",
    "allow-overlay-cancel"
  ]
}
