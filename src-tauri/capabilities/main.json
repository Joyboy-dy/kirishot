{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-app-info",
    "allow-settings-get",
    "allow-settings-update",
    "allow-open-save-folder",
    "dialog:allow-open",
    "allow-play-shutter-preview",
    "allow-history-list",
    "allow-history-thumb-path",
    "allow-history-copy",
    "allow-history-edit",
    "allow-history-reveal",
    "allow-history-delete",
    "allow-history-clear",
    "allow-start-capture",
    "allow-open-logs-folder",
    "allow-open-repository"
  ]
}
